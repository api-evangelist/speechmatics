                "description": "The project ID."
              }
            ]
          },
          "docs": "Get a project by ID"
        },
        {
          "info": {
            "name": "Update a project",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://asr.api.speechmatics.com/v2/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a project"
        },
        {
          "info": {
            "name": "Delete a project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://asr.api.speechmatics.com/v2/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID."
              }
            ]
          },
          "docs": "Delete a project"
        }
      ]
    }
  ],
  "bundled": true
