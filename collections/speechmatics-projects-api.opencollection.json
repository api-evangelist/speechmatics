{
  "opencollection": "1.0.0",
  "info": {
    "name": "Speechmatics Batch Transcription API Keys Projects API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://asr.api.speechmatics.com/v2/projects"
          },
          "docs": "Get all projects"
        },
        {
          "info": {
            "name": "Create a new project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://asr.api.speechmatics.com/v2/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new project"
        },
        {
          "info": {
            "name": "Get a project by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://asr.api.speechmatics.com/v2/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
